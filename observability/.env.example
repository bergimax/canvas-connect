# Copy to .env (next to this file) and fill in real values before running
# the production override on a real host:
#   docker compose -f observability/docker-compose.yml -f observability/docker-compose.prod.yml up -d
#
# Not needed for local dev — docker-compose.yml alone has working defaults
# for that (see ../observability/README.md). See docker-compose.prod.yml.

# Grafana admin password. Required, no default — docker-compose.yml's
# admin/admin default is dev-only, deliberately not reused here.
GRAFANA_ADMIN_PASSWORD=

# Public domain for automatic HTTPS via Caddy/Let's Encrypt, e.g. grafana.example.com.
# Leave empty to serve plain HTTP on the instance's IP for now.
SITE_ADDRESS=
