# Copy to .env and fill in real values before running the production
# override on a real host:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Not needed for local dev or tests — docker-compose.yml alone has working
# defaults for those. See docker-compose.prod.yml and README.md#configuration.

# Postgres password. Required, no default — the docker-compose.yml value
# ("canvas_connect") is a dev-only default, deliberately not reused here.
DB_PASSWORD=

# Public domain for automatic HTTPS via Caddy/Let's Encrypt, e.g. app.example.com.
# Leave empty to serve plain HTTP on the instance's IP for now.
SITE_ADDRESS=

# Origin used when building candidate guest-link URLs, e.g. https://app.example.com,
# or http://<instance-ip> if SITE_ADDRESS is empty.
FRONTEND_BASE_URL=
